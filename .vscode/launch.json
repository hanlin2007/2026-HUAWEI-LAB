{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug ADAS (WSL)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/wsl-debug/src/adas_demo",
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "preLaunchTask": "CMake: build (WSL)",
      "setupCommands": [{ "text": "-enable-pretty-printing", "ignoreFailures": true }]
    }
  ]
}
